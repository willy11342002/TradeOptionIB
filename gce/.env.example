# 複製成 gce/.env 再改值，不要進版控（跟根目錄 .env 的規則一樣，見
# app/paths.py 的說明）。三支 scripts/*.sh 都會讀這份檔案。

GCP_PROJECT_ID=your-gcp-project-id
# e2-micro 免費額度只在 us-central1/us-west1/us-east1 生效；台北在
# asia-east1 延遲最低但要付費(~$7/月)，選擇免費額度優先所以用 us-west1。
GCP_ZONE=us-west1-a
VM_NAME=ib-gateway-vm
# 用免費額度，OOM 風險見 README，配 swap file 緩解
MACHINE_TYPE=e2-micro
# 30GB 在 persistent disk 免費額度內
DISK_SIZE_GB=30
# e2-micro(1GB RAM) 用 swap 當 OOM 緩衝；e2-small 以上記憶體夠可以設 0
SWAP_SIZE_GB=2

# 上 https://github.com/IbcAlpha/IBC/releases 確認最新版本號再改
IBC_VERSION=3.21.0

# --- IBKR 帳密：01_create_vm.sh 會存進 GCP Secret Manager(不是
#     instance metadata)，只授權這台 VM 專用的 service account 讀取，
#     不會寫進任何進版控的檔案，只留在這份被 .gitignore 排除的 .env
#     跟 Secret Manager 裡。---
IB_LOGIN_PAPER=your_paper_account
IB_PASSWORD_PAPER=your_paper_password
IB_LOGIN_LIVE=your_live_account
IB_PASSWORD_LIVE=your_live_password

# e2-micro(1GB) 建議先 false，只跑 paper 觀察穩定後再切 true，改完這個
# 值要跑 gce/scripts/03_update_and_restart.sh 才會生效。
ENABLE_LIVE=false
