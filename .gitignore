__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# kgisuperpy 套件執行時自動複製到工作目錄的範例/資料檔 (已改用 RTD 方案，非本專案程式碼)
example/
errMsg.ini
TradeCom.*.log

# 加密後的登入帳密快取 (DPAPI 二進位，僅本機可解密)
.kgi_credentials.bin

# 本機使用者偏好設定 (深色模式等)
.theme_pref.json

# API 金鑰設定，不進版控 (參考 .env.example 填自己的 key)
.env

# 開倉判斷紀錄，本機執行期產生
open_position_history.jsonl

# 期交所選擇權波動率指數本地增量快取 (本機執行期產生/累積)
data/taiwan_option_vix.csv
