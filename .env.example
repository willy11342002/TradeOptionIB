FINMIND_API_TOKEN=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=moonshotai/kimi-k2
# IB Gateway 連線資訊——NiceGUI 版(main.py)沒有連線表單，開程式就直接用
# 這兩個值連線，模擬/正式環境用畫面右上角的按鈕切換(port 4002/4001 自動
# 決定，不用另外設定)。
IB_HOST=127.0.0.1
IB_CLIENT_ID=1

# --- docker-compose(根目錄 docker-compose.yml)常駐 IB Gateway 用的帳
#     密，跟 gce/.env 是同一組帳號分開填一份——本機 docker 跟 GCE VM
#     是兩個獨立部署，各自的 .env 都要有完整帳密才能連線。IB_HOST/
#     IB_CLIENT_ID 不用因為改用 docker 而調整，對外 port 刻意對齊原生
#     Gateway 預設值(見 docker-compose.yml 說明)。---
IB_LOGIN_PAPER=your_paper_account
IB_PASSWORD_PAPER=your_paper_password
IB_LOGIN_LIVE=your_live_account
IB_PASSWORD_LIVE=your_live_password
# both=live+paper 一起常駐，只想跑模擬帳戶就改成 paper 並把上面兩個
# IB_LOGIN_LIVE/IB_PASSWORD_LIVE 留空
IB_TRADING_MODE=both
# 選填，只有要用 VNC 手動排查(見 docker-compose.yml)才需要填
IB_VNC_PASSWORD=
